# FusionSolar northbound API — battery SOC and consumption
FUSIONSOLAR_USER=your_northbound_username
FUSIONSOLAR_PASSWORD=your_northbound_system_code
FUSIONSOLAR_PLANT_ID=your_station_code
FUSIONSOLAR_DEVICE_ID=your_battery_device_id
# FUSIONSOLAR_HOST=uni005eu5.fusionsolar.huawei.com  # override if your region differs

# forecast.solar — solar production forecast
FORECAST_SOLAR_API_KEY=your_api_key_here
SOLAR_LAT=51.0
SOLAR_LON=4.0
SOLAR_DECLINATION=19
SOLAR_AZIMUTH=30
SOLAR_KWP=8.03
